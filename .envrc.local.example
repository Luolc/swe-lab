# Local secrets for direnv. Copy to `.envrc.local` (gitignored; `.envrc` sources
# it), then `direnv allow`. Values are never written here: each line reads one
# item from the 1Password `dev-shared` vault via `op read`, which needs
# OP_SERVICE_ACCOUNT_TOKEN in the environment. The vault, the service account,
# and the token setup are owned by machine-setup ADR-0013:
# https://github.com/Luolc/machine-setup/blob/main/docs/adr/0013-workstation-secrets-via-service-account.md
# The three variables and what consumes them: docs/conventions.md → Secrets.
#
# Without the 1Password service-account token, `op read` would prompt
# interactively and hang direnv. Skip with a hint instead (return, not
# exit: direnv sources this file from .envrc). See machine-setup ADR-0013.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  echo "op-secrets: OP_SERVICE_ACCOUNT_TOKEN missing; open a new login shell (machine-setup ADR-0013)" >&2
  return 0
fi
export HF_TOKEN=$(op read --no-newline --force "op://dev-shared/hf-token/credential")
# NOT named CLAUDE_CODE_OAUTH_TOKEN: direnv exports these into every shell under
# this directory, and the `claude` CLI logs in with that name if it sees it —
# with an inference-only token, which breaks Remote Control. The sandbox renames
# it back for the agent. See docs/conventions.md → Hazards.
export SWE_LAB_CLAUDE_CODE_OAUTH_TOKEN=$(op read --no-newline --force "op://dev-shared/claude-code-oauth-token/credential")
export OPENROUTER_API_KEYS=$(op read --no-newline --force "op://dev-shared/openrouter-api-keys/credential")
